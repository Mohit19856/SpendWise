# ---------------------------------------------------------------------------
# SpendWise environment configuration - EXAMPLE FILE
# ---------------------------------------------------------------------------
# Copy this file to ".env" and replace the placeholder values.
# NEVER commit the real ".env" file to GitHub (it is already in .gitignore).
#
# Windows PowerShell:
#   Copy-Item .env.example .env
# Linux / macOS / EC2:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Flask needs a secret key to sign session cookies and CSRF tokens.
# Generate a strong one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# development | testing | production
FLASK_CONFIG=development

# Database location.
# Relative SQLite paths point to the "instance/" folder of the project.
# Example for EC2 with a persistent volume: sqlite:////var/lib/spendwise/spendwise.db
DATABASE_URL=sqlite:///spendwise.db

# Optional: HTTP port used by run.py locally (default 5000)
PORT=5000
